<!--
    The launcher icon foreground: the same bowl and leaf as the in-app logo.

    Adaptive icons are 108x108, but phones crop the outer edges to whatever shape
    they use, so anything important has to sit inside the middle 72x72. All the
    artwork below is kept well within that safe area.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bowl -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,58 h44 c0,12.2 -9.8,22 -22,22 s-22,-9.8 -22,-22 z" />

    <!-- Bowl base -->
    <path
        android:fillColor="#E8F5E9"
        android:pathData="M43,82 h22 v4 h-22 z" />

    <!-- Right half of the leaf -->
    <path
        android:fillColor="#A5D6A7"
        android:pathData="M54,28 c7.5,2 11,7.5 11,15 c-7.5,-2 -11,-7.5 -11,-15 z" />

    <!-- Left half of the leaf -->
    <path
        android:fillColor="#81C784"
        android:pathData="M54,28 c-7.5,2 -11,7.5 -11,15 c7.5,-2 11,-7.5 11,-15 z" />

    <!-- Stem -->
    <path
        android:fillColor="#A5D6A7"
        android:pathData="M52.5,41 h3 v14 h-3 z" />

</vector>
