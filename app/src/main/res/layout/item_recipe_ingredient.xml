<?xml version="1.0" encoding="utf-8"?>
<!-- One ingredient line on the recipe detail screen, with a have/missing icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp">

    <!--
        The icon and its description are both set from Java, because they depend on
        whether the user has this ingredient. A default description is given here so
        the view is never left unlabelled for screen readers.
    -->
    <ImageView
        android:id="@+id/imageStatus"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/have_ingredient"
        tools:src="@drawable/ic_check" />

    <TextView
        android:id="@+id/textIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        tools:text="200 g pasta" />

</LinearLayout>
