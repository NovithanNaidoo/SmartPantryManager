<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Every Activity must be declared here. An Activity missing from the manifest
        compiles perfectly well and then crashes the moment the app tries to open it,
        which makes it a genuinely easy mistake to overlook.

        No permissions are requested anywhere in this file. The app stores everything
        locally in SQLite and uses no internet, camera or location features. The brief
        explicitly forbids maps, GPS and location services, and none are present.
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager"
        tools:targetApi="31">

        <!--
            The launcher Activity. The intent-filter below is what tells Android this
            is the screen to open when the user taps the app icon, and it is why this
            Activity also needs android:exported="true" — it is started from outside
            the app.
        -->
        <activity
            android:name=".ui.PantryListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The add/edit form. exported="false" because only this app opens it.
            parentActivityName gives the back arrow somewhere sensible to go.
        -->
        <activity
            android:name=".ui.AddEditIngredientActivity"
            android:exported="false"
            android:parentActivityName=".ui.PantryListActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Suggested recipes. Reached from the pantry list toolbar menu. -->
        <activity
            android:name=".ui.SuggestedRecipesActivity"
            android:exported="false"
            android:parentActivityName=".ui.PantryListActivity" />

        <!-- Full detail for one recipe. Opened by tapping any recipe row. -->
        <activity
            android:name=".ui.RecipeDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.SuggestedRecipesActivity" />

    </application>

</manifest>
